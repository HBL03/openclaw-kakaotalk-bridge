{
  "name": "openclaw-kakao-channel",
  "version": "0.1.0-dev.1",
  "description": "Private loopback channel for the Windows KakaoTalk self-chat bridge",
  "type": "module",
  "license": "MIT",
  "files": ["dist", "openclaw.plugin.json", "README.md"],
  "main": "dist/index.js",
  "openclaw": {
    "extensions": ["./dist/index.js"],
    "channel": {
      "id": "kakao-local",
      "label": "KakaoTalk Local",
      "selectionLabel": "KakaoTalk — local self chat",
      "docsPath": "/channels/kakao-local",
      "blurb": "Windows self-chat only; requires the paired local bridge"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts"
  },
  "engines": {"node": ">=24.16.0 <25"},
  "peerDependencies": {"openclaw": "2026.10.2"},
  "dependencies": {"ws": "8.18.3"},
  "devDependencies": {
    "openclaw": "2026.10.2",
    "@types/node": "24.0.3",
    "@types/ws": "8.18.1",
    "tsx": "4.20.3",
    "typescript": "5.8.3"
  }
}
